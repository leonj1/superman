# The default is a textured, credential-free offline fixture. For the live hybrid
# world, create a domain-restricted Cesium ion token with terrain, imagery, and
# OSM Buildings access.
VITE_CESIUM_ION_TOKEN=
VITE_TILE_PROVIDER=auto
VITE_QUALITY_PROFILE=high
VITE_ENABLE_HERO_ZONE=true
VITE_ENABLE_TELEMETRY=false
VITE_API_URL=http://localhost:8787

# Legacy comparison mode only; Google is never automatically selected.
VITE_GOOGLE_MAP_TILES_KEY=
