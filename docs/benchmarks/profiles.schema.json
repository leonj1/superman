{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["profiles"],
  "properties": {
    "profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "os",
          "browser",
          "cpu",
          "gpu",
          "memoryGb",
          "width",
          "height",
          "devicePixelRatio",
          "network"
        ]
      }
    }
  }
}
